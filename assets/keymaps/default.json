[
  {
    "bindings": {
      "secondary-q": "air::Quit"
    }
  },
  {
    "context": "Workspace",
    "bindings": {
      "secondary-k": "air::OpenPalette",
      "secondary-/": "air::ShowShortcuts",
      "alt-down": "air::NextChat",
      "alt-up": "air::PrevChat",
      "ctrl-tab": "air::NextChat",
      "ctrl-shift-tab": "air::PrevChat",
      "alt-shift-down": "air::NextUnreadChat",
      "alt-shift-up": "air::PrevUnreadChat",
      "secondary-l": "air::FocusConversation",
      "secondary-m": "air::FocusMessages",
      "secondary-i": "air::ToggleDetails",
      "secondary-n": "air::AddContact",
      "secondary-shift-n": "air::NewGroup",
      "secondary-o": "air::AttachFile",
      "secondary-,": "air::OpenSettings",
      "secondary-enter": "air::AcceptRequest",
      "secondary-shift-backspace": "air::DeclineRequest",
      "secondary-shift-t": "air::ToggleAppearance",
      "secondary-1": ["air::OpenChatAt", { "index": 0 }],
      "secondary-2": ["air::OpenChatAt", { "index": 1 }],
      "secondary-3": ["air::OpenChatAt", { "index": 2 }],
      "secondary-4": ["air::OpenChatAt", { "index": 3 }],
      "secondary-5": ["air::OpenChatAt", { "index": 4 }],
      "secondary-6": ["air::OpenChatAt", { "index": 5 }],
      "secondary-7": ["air::OpenChatAt", { "index": 6 }],
      "secondary-8": ["air::OpenChatAt", { "index": 7 }],
      "secondary-9": ["air::OpenChatAt", { "index": 8 }]
    }
  },
  {
    "context": "ChatList",
    "bindings": {
      "j": "air::SelectNext",
      "k": "air::SelectPrev",
      "down": "air::SelectNext",
      "up": "air::SelectPrev",
      "enter": "air::FocusConversation"
    }
  },
  {
    "context": "Settings",
    "bindings": {
      "down": "air::SelectNext",
      "up": "air::SelectPrev",
      "j": "air::SelectNext",
      "k": "air::SelectPrev",
      "home": "air::SelectFirst",
      "end": "air::SelectLast",
      "right": "air::SettingNext",
      "left": "air::SettingPrev",
      "l": "air::SettingNext",
      "h": "air::SettingPrev",
      "enter": "air::SettingNext",
      "escape": "air::CloseSettings"
    }
  },
  {
    "context": "MessageList",
    "bindings": {
      "down": "air::CursorDown",
      "up": "air::CursorUp",
      "home": "air::CursorFirst",
      "end": "air::CursorLast",
      "pagedown": "air::HalfPageDown",
      "pageup": "air::HalfPageUp",
      "secondary-c": "air::YankMessage",
      "enter": "air::OpenLinks",
      "e": "air::EditMessage",
      "r": "air::ReplyToMessage",
      "+": "air::PickReaction",
      "s": "air::SaveAttachment"
    }
  },
  {
    "context": "MessageList && reacting",
    "bindings": {
      "1": ["air::React", { "index": 0 }],
      "2": ["air::React", { "index": 1 }],
      "3": ["air::React", { "index": 2 }],
      "4": ["air::React", { "index": 3 }],
      "5": ["air::React", { "index": 4 }],
      "6": ["air::React", { "index": 5 }],
      "escape": "air::PickReaction"
    }
  },
  {
    "context": "Composer > Input",
    "bindings": {
      "up": "air::EditLastMessage",
      "escape": "air::CancelCompose"
    }
  },
  {
    "context": "CommandLine",
    "bindings": {
      "tab": "air::CommandComplete",
      "escape": "air::CommandCancel"
    }
  },
  {
    "context": "Conversation",
    "bindings": {
      "escape": "air::FocusChatList"
    }
  }
]
